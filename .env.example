# ─── Front (Vite, préfixe VITE_) ─────────────────────────────────────────────
# Sans VITE_FACTORY_API_BASE, le dashboard reste en mode MAQUETTE (GitHub Pages).
# Branché, il poll GET /api/factory-state toutes les 30 s et bascule en LIVE.
# Copier ce fichier vers `.env.local` pour le développement local.
VITE_FACTORY_API_BASE=http://localhost:8787
VITE_FACTORY_POLL_MS=30000
VITE_APPROVE_TOKEN=

# ─── Serveur (server/factoryState.ts) ───────────────────────────────────────
# Token Bearer exigé sur POST /api/dock/approve — jamais en dur dans le front.
APPROVE_TOKEN=
NOTION_TOKEN=
NOTION_IDEAS_DB_ID=
RECRUTMATCH_API_URL=
HCHECK_MAC=
HCHECK_HERMES6=
HCHECK_RENDER=
HCHECK_ORACLE=
FACTORY_PORT=8787